# Required for Vercel builds and production API access.
# Use the public HTTPS Cloudflare Worker URL (custom domain preferred).
VITE_API_URL=https://api.example.com
VITE_API_VERSION_PREFIX=/api/v1
VITE_SITE_URL=https://your-project.vercel.app

# Required when Supabase Auth is enabled in this frontend.
# Update the redirect URLs after the first deploy if you switch to a custom domain.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_AUTH_REDIRECT_URL=https://your-project.vercel.app/login
VITE_SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://your-project.vercel.app/forgot-password?recovery=1

# Optional integrations and feature flags
VITE_ENABLE_REALTIME_CHAT=false
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_GROUP_DEALS=true

# Preferred public WhatsApp number. Legacy aliases below can stay empty if unused.
VITE_WHATSAPP_NUMBER=919999999999
VITE_CONSTRUCTION_WHATSAPP_NUMBER=
VITE_CONSTRUCT_WHATSAPP_NUMBER=
VITE_CONSTRUCTION_WHATSAPP_TEXT=Hi ZDT Realty, I want to start my construction journey.
VITE_SUPPORT_UPI_QR_URL=
