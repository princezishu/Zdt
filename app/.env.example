# Required on Vercel
# Production example: https://your-backend.example.com
# Local development example: http://localhost:5000
VITE_API_URL=https://your-backend.example.com
VITE_API_VERSION_PREFIX=/api/v1
VITE_SITE_URL=https://your-frontend-domain.vercel.app

# Required when Supabase Auth is enabled
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional overrides for auth redirects.
# Add both preview and production frontend URLs to the Supabase redirect allow-list.
VITE_SUPABASE_AUTH_REDIRECT_URL=https://your-frontend-domain.vercel.app/login
VITE_SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://your-frontend-domain.vercel.app/forgot-password?recovery=1

# Required for pages that render Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional feature and support settings
VITE_ENABLE_GROUP_DEALS=true
VITE_WHATSAPP_NUMBER=8217037667
VITE_CONSTRUCTION_WHATSAPP_NUMBER=918217037667
VITE_CONSTRUCT_WHATSAPP_NUMBER=
VITE_CONSTRUCTION_WHATSAPP_TEXT=Hi ZDT Realty, I want to start my construction journey.
VITE_SUPPORT_UPI_QR_URL=
