# Preferred: use a Supabase Postgres connection string.
# Use the Supabase pooler URL when available.
SUPABASE_DB_POOLER_URL=
# Optional generic alias if your deployment platform exposes only DATABASE_URL.
DATABASE_URL=
# Optional host-based Supabase credentials if you do not use a connection string.
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=6543
# Legacy fallback vars. Keep only if you are not ready to switch env names yet.
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=
# Keep true in production for managed PostgreSQL over TLS.
DB_SSL=true
# Supabase pooler connections typically work with rejectUnauthorized=false unless you provide a CA bundle.
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional PEM CA certificate string; use \n for line breaks.
# Some providers require this CA bundle for TLS validation.
DB_SSL_CA=
JWT_SECRET=replace_with_strong_random_secret
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
PORT=5000
HOST=0.0.0.0
# Keep true for the current deployment phase so every frontend origin is allowed.
# Set this to false only after you are ready to lock CORS down to explicit domains.
CORS_ALLOW_ALL=true
# Optional allow-list values for the later locked-down CORS phase.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set trusted proxy hops (1 is common behind a single reverse proxy/load balancer).
# Use `true` only when every inbound request passes through trusted proxy infrastructure.
TRUST_PROXY=1
# Keep true in production when TLS terminates at reverse proxy/load balancer.
FORCE_HTTPS=true
APP_NAME=ZDT Realty
AUTH_AUTO_REVOKE_OLDEST_SESSION_ON_LIMIT=true
ADMIN_TOKEN=replace_with_a_long_random_admin_token
MAIN_ADMIN_NAME=ZDT Realty Owner
MAIN_ADMIN_EMAIL=admin@example.com
MAIN_ADMIN_PASSWORD=ChangeThisStrongPassword123!
MAIN_ADMIN_PHONE=+910000000000
SUPPORT_UPI_QR_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Managed auth transition (optional)
MANAGED_AUTH_PROVIDER=
# Keep false initially. When true, verified managed identities with matching emails auto-link.
MANAGED_AUTH_AUTO_LINK_BY_EMAIL=false
SUPABASE_PROJECT_URL=
# Optional override. Defaults to ${SUPABASE_PROJECT_URL}/auth/v1 when project URL is set.
SUPABASE_JWT_ISSUER=
# Optional override. Defaults to ${SUPABASE_JWT_ISSUER}/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Optional audience validation for asymmetric JWT projects.
SUPABASE_JWT_AUDIENCE=
# Required only when Supabase access tokens are signed with HS256.
SUPABASE_ANON_KEY=
# Optional. Leave false for local development unless Redis server version is >= 5.0.0.
# When REDIS_URL is set, the same Redis instance is also used for distributed API rate limiting.
ENABLE_REDIS_QUEUE=false
REDIS_URL=redis://127.0.0.1:6379
# BullMQ requires Redis server version >= 5.0.0 when ENABLE_REDIS_QUEUE=true.
REDIS_PING_TIMEOUT_MS=5000
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TIMEOUT_MS=3000
ENABLE_INGEST_JOBS=false
INFRA_PIB_RSS_FEEDS=PIB_REG_1|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1,PIB_REG_2|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=2,PIB_REG_3|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
INFRA_PIB_MAX_FEEDS=20
INFRA_PIB_REQUEST_RETRIES=4
INFRA_PIB_ATTEMPTS_PER_FEED=3
INFRA_PIB_ATTEMPT_DELAY_MS=1500
# Delay between PIB feeds (helps reduce transient resets on pib.gov.in)
INFRA_PIB_FEED_DELAY_MS=1200
# Set true to log every retry attempt; false logs only final outcome per feed.
INFRA_PIB_LOG_RETRIES=false
# Cooldown for a PIB feed after transient failures to avoid repetitive log noise.
INFRA_PIB_TRANSIENT_COOLDOWN_MINUTES=30
INFRA_PIB_TIMEOUT_MS=25000
INFRA_ENABLE_TENDER_SOURCES=false
# Retry count for non-PIB sources (eTenders/eProcure/PPP).
INFRA_SOURCE_REQUEST_RETRIES=2
# Timeout for non-PIB sources.
INFRA_SOURCE_TIMEOUT_MS=25000
# Cooldown after transient source failures to prevent repetitive error logs.
INFRA_SOURCE_TRANSIENT_COOLDOWN_MINUTES=30
# Comma-separated KEY|URL pairs, e.g.
# ETENDERS_NHAI|https://etenders.gov.in/eprocure/app,ETENDERS_MAIN|https://etenders.gov.in/eprocure/app
# Set to DISABLED to skip this source type.
INFRA_ETENDERS_URLS=ETENDERS_MAIN|https://etenders.gov.in/eprocure/app
# Comma-separated KEY|URL pairs, e.g.
# EPROCURE_MORTH|https://eprocure.gov.in/eprocure/app,EPROCURE_MAIN|https://eprocure.gov.in/eprocure/app
# Set to DISABLED to skip this source type.
INFRA_EPROCURE_URLS=EPROCURE_MAIN|https://eprocure.gov.in/eprocure/app
INFRA_PPP_URLS=PPPINDIA_MAIN|https://www.pppinindia.gov.in/all_infrastructure_projects
INFRA_INGEST_MAX_ITEMS_PER_SOURCE=200
# Set true for extra ingest diagnostics (source-disabled messages, etc.)
INFRA_INGEST_VERBOSE=false
INFRA_INGEST_ORG_FILTERS=
INFRA_INGEST_CLASS_FILTERS=
INFRA_INGEST_LOCATION_FILTERS=
INFRA_INGEST_CLOSING_DATE_FROM=
TENDER_INTELLIGENCE_DAILY_REFRESH_CRON=15 6 * * *
TENDER_INTELLIGENCE_DAILY_REFRESH_TIMEZONE=Asia/Kolkata
EAUCTION_SYNC_ENABLED=true
EAUCTION_SYNC_STARTUP_ENABLED=true
EAUCTION_SYNC_CRON=45 6 * * *
EAUCTION_SYNC_TIMEZONE=Asia/Kolkata
MEDIA_SIGNING_SECRET=replace_with_strong_media_signing_secret
MEDIA_SIGNED_URL_TTL_SECONDS=900
# Runtime media uploads use Cloudinary + memory buffers, not local upload directories.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zdt
APARTMENT_RENT_LATE_PENALTY_PERCENT=5
# Optional read-only dataset path for location suggestions. This is not used for user-uploaded media.
INDIA_VILLAGE_DATA_PATH=data/village-directory.csv
INDIA_VILLAGE_DATA_ZIP_URL=https://raw.githubusercontent.com/planemad/india-local-government-directory/main/village-directory.csv.zip

# Email OTP + Newsletter (SMTP sender)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=ZDT Realty <support@zdtrealty.com>

# SMS OTP (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# Insights market provider (optional)
MARKET_API_PROVIDER=
MARKET_API_KEY=
MARKET_API_URL=

# AI real-estate chatbot (optional)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
