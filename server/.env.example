REDIS_URL=redis://127.0.0.1:6379
REDIS_PING_TIMEOUT_MS=5000
ENABLE_INGEST_JOBS=false
INFRA_PIB_RSS_FEEDS=PIB_REG_1|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1,PIB_REG_2|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=2,PIB_REG_3|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
INFRA_PIB_MAX_FEEDS=20
INFRA_PIB_REQUEST_RETRIES=4
INFRA_PIB_ATTEMPTS_PER_FEED=3
INFRA_PIB_ATTEMPT_DELAY_MS=1500
# Delay between PIB feeds (helps reduce transient resets on pib.gov.in)
INFRA_PIB_FEED_DELAY_MS=1200
# Set true to log every retry attempt; false logs only final outcome per feed.
INFRA_PIB_LOG_RETRIES=false
# Cooldown for a PIB feed after transient failures to avoid repetitive log noise.
INFRA_PIB_TRANSIENT_COOLDOWN_MINUTES=30
INFRA_PIB_TIMEOUT_MS=25000
INFRA_ENABLE_TENDER_SOURCES=false
# Retry count for non-PIB sources (eTenders/eProcure/PPP).
INFRA_SOURCE_REQUEST_RETRIES=2
# Timeout for non-PIB sources.
INFRA_SOURCE_TIMEOUT_MS=25000
# Cooldown after transient source failures to prevent repetitive error logs.
INFRA_SOURCE_TRANSIENT_COOLDOWN_MINUTES=30
# Comma-separated KEY|URL pairs, e.g.
# ETENDERS_NHAI|https://etenders.gov.in/eprocure/app,ETENDERS_MAIN|https://etenders.gov.in/eprocure/app
# Set to DISABLED to skip this source type.
INFRA_ETENDERS_URLS=ETENDERS_MAIN|https://etenders.gov.in/eprocure/app
# Comma-separated KEY|URL pairs, e.g.
# EPROCURE_MORTH|https://eprocure.gov.in/eprocure/app,EPROCURE_MAIN|https://eprocure.gov.in/eprocure/app
# Set to DISABLED to skip this source type.
INFRA_EPROCURE_URLS=EPROCURE_MAIN|https://eprocure.gov.in/eprocure/app
INFRA_PPP_URLS=PPPINDIA_MAIN|https://www.pppinindia.gov.in/all_infrastructure_projects
INFRA_INGEST_MAX_ITEMS_PER_SOURCE=200
# Set true for extra ingest diagnostics (source-disabled messages, etc.)
INFRA_INGEST_VERBOSE=false
INFRA_INGEST_ORG_FILTERS=
INFRA_INGEST_CLASS_FILTERS=
INFRA_INGEST_LOCATION_FILTERS=
INFRA_INGEST_CLOSING_DATE_FROM=
MEDIA_SIGNING_SECRET=replace_with_strong_media_signing_secret
MEDIA_SIGNED_URL_TTL_SECONDS=900
PRIVATE_UPLOADS_ROOT=
APARTMENT_RENT_LATE_PENALTY_PERCENT=5
